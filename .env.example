APP_NAME=DMV-ROM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Application database — MariaDB 10.6 to match Stormweb production.
# DB_HOST is the docker-compose service name (resolved inside the sail network).
# FORWARD_DB_PORT exposes MariaDB on a non-default host port to avoid
# conflicts with anything else bound to 3306 on your machine.
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=dmv_rom_v2
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=3307

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# The app sends over the host's own mail server (spec #479, ADR-0024): the smtp mailer,
# STARTTLS on port 587, authenticated as the dedicated app mailbox. Production sets these;
# staging keeps MAIL_MAILER=log so the scheduler runs without spending the shared daily cap.
MAIL_MAILER=log
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
