{
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.9.0",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "prepare": "husky",
        "sandcastle": "npx tsx .sandcastle/main.ts",
        "sail": "sh vendor/bin/sail",
        "db:seed": "sh vendor/bin/sail artisan db:seed",
        "db:fresh": "sh vendor/bin/sail artisan migrate:fresh --seed",
        "sail:up": "sh vendor/bin/sail up -d",
        "sail:down": "sh vendor/bin/sail down",
        "sail:logs": "sh vendor/bin/sail logs -f",
        "sail:shell": "sh vendor/bin/sail shell",
        "typecheck": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@ai-hero/sandcastle": "^0.10.0",
        "@eslint/js": "^10.0.1",
        "@vue/eslint-config-typescript": "^14.9.0",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-vue": "^10.9.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8",
        "prettier": "^3.8.4",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "typescript-eslint": "^8.62.0"
    },
    "dependencies": {
        "@headlessui/vue": "^1.7.23",
        "@inertiajs/vue3": "^3.5.0",
        "@phosphor-icons/vue": "^2.2.1",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/vite": "^4.3.1",
        "@types/node": "^25.9.3",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vueuse/core": "^14.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "laravel-vue-i18n": "^2.8.0",
        "radix-vue": "^1.9.11",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.1",
        "tw-animate-css": "^1.2.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vue": "^3.5.39",
        "vue-tsc": "^3.3.5",
        "ziggy-js": "^2.6.3"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.62.0",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "lint-staged": {
        "*.php": "vendor/bin/pint",
        "*.{js,ts,vue}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.{css,md,json,jsonc,yaml,yml,html}": "prettier --write"
    }
}
