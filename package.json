{
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.0.9",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "prepare": "husky",
        "sail": "sh vendor/bin/sail",
        "sail:up": "sh vendor/bin/sail up -d",
        "sail:down": "sh vendor/bin/sail down",
        "sail:logs": "sh vendor/bin/sail logs -f",
        "sail:shell": "sh vendor/bin/sail shell",
        "typecheck": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vue/eslint-config-typescript": "^14.3.0",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-vue": "^10.9.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.5",
        "prettier": "^3.4.2",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "typescript-eslint": "^8.59.4"
    },
    "dependencies": {
        "@headlessui/vue": "^1.7.23",
        "@inertiajs/vue3": "^3.2.0",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/vite": "^4.3.0",
        "@types/node": "^25.9.1",
        "@types/ziggy-js": "^1.3.3",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vueuse/core": "^14.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "lucide": "^1.16.0",
        "lucide-vue-next": "^1.0.0",
        "radix-vue": "^1.9.11",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.0",
        "tw-animate-css": "^1.2.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.14",
        "vue": "^3.5.13",
        "vue-tsc": "^3.3.1",
        "ziggy-js": "^2.4.2"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.60.4",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "lint-staged": {
        "*.php": "vendor/bin/sail pint",
        "*.{js,ts,vue}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.css": "prettier --write"
    }
}
